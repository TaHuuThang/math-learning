{
  "name": "math-learning",
  "version": "0.3.0",
  "description": "THANG MATH LEARNING – website học Toán THCS (Toán 6–9) của Tạ Hữu Thắng, triển khai trước Toán 8 Kết nối tri thức với cuộc sống.",
  "author": "Tạ Hữu Thắng",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/server.mjs serve",
    "migrate": "node dist/server.mjs migrate",
    "seed": "node dist/server.mjs seed",
    "create-admin": "node dist/server.mjs create-admin",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "test:e2e": "node test/e2e/run.mjs",
    "typecheck:offline": "tsc --noEmit -p tsconfig.offline.json",
    "export-html": "node dist/server.mjs export-html --out math-learning-html",
    "test:html": "node test/e2e/static.mjs math-learning-html",
    "docs": "node dist/server.mjs export-html --out docs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "katex": "^0.16.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
