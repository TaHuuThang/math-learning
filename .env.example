# Sao chép tệp này thành .env rồi điền thông tin.

# Chuỗi kết nối PostgreSQL (bắt buộc).
#  - Máy cài PostgreSQL:    postgres://ten_nguoi_dung:mat_khau@localhost:5432/math_learning
#  - Dịch vụ đám mây (Neon, Supabase…): thêm ?sslmode=require ở cuối
DATABASE_URL=postgres://mathapp:doi_mat_khau_nay@localhost:5432/math_learning

# Cổng web (mặc định 3000). HOST=0.0.0.0 để máy khác trong mạng LAN của trường truy cập được.
PORT=3000
HOST=0.0.0.0

# Đặt 1 khi chạy sau proxy/HTTPS (Nginx, Caddy, Render, Railway…) để lấy đúng IP và giao thức.
TRUST_PROXY=0

# Cookie chỉ gửi qua HTTPS: auto (tự nhận biết) | always | never
COOKIE_SECURE=auto

# Số ngày giữ đăng nhập
SESSION_DAYS=30

# Tự cập nhật cấu trúc CSDL và nạp chương trình Toán 8 khi khởi động (0 để tắt)
AUTO_MIGRATE=1

# Số kết nối CSDL tối đa
DB_POOL_MAX=10
